<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SignalWatchdogs</AssemblyName>
    <RootNamespace>SignalWatchdogs</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <Version>1.1.0</Version>
    <Product>Signal Watchdogs</Product>
    <AssemblyTitle>Signal Watchdogs</AssemblyTitle>
    <Description>Surveillance des écrans, cartes graphiques, USB/USB-C et sessions distantes</Description>
    <Copyright>Signal Watchdogs</Copyright>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('assets\SignalWatchdogs.ico')">
    <ApplicationIcon>assets\SignalWatchdogs.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
